# Use an explicit Node installation without requiring a global installation.
if [ -n "${AGENTPAY_NODE:-}" ]; then
  case "$AGENTPAY_NODE" in
    /*) node_path=$AGENTPAY_NODE ;;
    *) printf '%s\n' 'AGENTPAY_NODE must be the full path to your Node executable.' >&2; exit 1 ;;
  esac
else
  node_path=$(command -v node) || {
    printf '%s\n' 'Node was not found. Set AGENTPAY_NODE to its full path, then retry.' 'Example: AGENTPAY_NODE=/path/to/node ./run help' >&2
    exit 1
  }
fi
if [ ! -f "$node_path" ] || [ ! -x "$node_path" ]; then
  printf '%s\n' 'The selected Node executable does not exist or is not executable. Check AGENTPAY_NODE.' >&2
  exit 1
fi
case "$node_path" in
  /*) ;;
  *) node_path="$PWD/$node_path" ;;
esac
# npm and its child scripts must see the same selected Node installation.
PATH="${node_path%/*}:${PATH:-/usr/bin:/bin}"
export PATH
run_dir=$(CDPATH= cd -- "${0%/*}" && pwd -P) || exit 1
exec "$node_path" "$run_dir/scripts/agentpay-cli.mjs" "$@"
