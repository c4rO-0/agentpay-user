{
  "name": "@c4roa0/agentpay-user",
  "version": "0.3.15",
  "type": "module",
  "dependencies": {
    "@c4roa0/agentpay-protocol": "0.14.3",
    "@c4roa0/agentpay-wallet": "0.3.4",
    "ethers": "^6.17.0",
    "fs-native-extensions": "1.5.3"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "check": "node --check src/index.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:invocation-store": "node --test test/invocation-store.test.mjs",
    "test:prepare-onboarding": "node --test test/prepare-onboarding.test.mjs",
    "test:installation-guide": "node --test test/install-user.test.mjs test/install-and-setup.test.mjs test/guided-setup.test.mjs test/prepare-onboarding.test.mjs",
    "test:market-connection": "node --test test/connect-market.test.mjs test/local-wallet-ipc.test.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "license": "MPL-2.0",
  "bin": {
    "agentpay": "scripts/agentpay-cli.mjs"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "files": [
    "src/",
    "scripts/",
    "web/*.html",
    "web/*.js",
    "run",
    "update-pair.json",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "progress.md",
    "AGENTS.md",
    "doc/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c4rO-0/agentpay-user.git"
  },
  "description": "Local AgentPay Runtime and guided Wallet setup for AI Agents",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
